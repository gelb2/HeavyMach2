{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HeavyMach 2 Desktop",
  "version": "0.1.0",
  "identifier": "com.gelb2.heavymach2.desktop",
  "build": {
    "frontendDist": "../build/frontend",
    "beforeBuildCommand": "python3 scripts/prepare.py"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; media-src 'self' blob:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["../build/icons/32x32.png", "../build/icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    }
  }
}
