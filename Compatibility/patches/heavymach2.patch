+        use std::io::Write;
+        let path = std::path::PathBuf::from(directory).join(format!("{}-{}.ppm", label, n));
+        if let Ok(mut file) = std::fs::File::create(path) {
+            let _ = write!(file, "P6\n{} {}\n255\n", width, height);
+            for row in pixels.chunks_exact(width as usize * 4).rev() {
+                let rgb: Vec<u8> = row.chunks_exact(4).flat_map(|p| p[..3].iter().copied()).collect();
+                let _ = file.write_all(&rgb);
+            }
+        }
+    }
