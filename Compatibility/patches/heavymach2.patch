@@ -0,0 +1,50 @@
+/* MPL-2.0. Darwin's default degree-31, separation-3 additive random sequence.
+ * Algorithm reference: apple-oss-distributions/Libc/stdlib/FreeBSD/random.c.
+ * Keeps state per guest Environment; no host-global RNG coupling.
+ */
+pub struct BsdRandom { words: [u32; 31], front: usize, rear: usize }
+impl Default for BsdRandom { fn default() -> Self { Self::seeded(1) } }
+impl BsdRandom {
+    pub fn seeded(seed: u32) -> Self {
+        let mut r = Self { words: [0;31], front:3, rear:0 };
+        r.words[0] = seed;
+        for i in 1..31 {
+            let mut x = r.words[i-1] as i32 as i64;
+            if x == 0 { x = 123459876; }
+            x = 16807 * (x % 127773) - 2836 * (x / 127773);
+            if x < 0 { x += 0x7fffffff; }
+            r.words[i] = x as u32;
+        }
+        for _ in 0..310 { r.next(); }
+        r
+    }
+    pub fn next(&mut self) -> i32 {
+        let sum = self.words[self.front].wrapping_add(self.words[self.rear]);
+        self.words[self.front] = sum;
+        self.front = (self.front + 1) % 31;
+        self.rear = (self.rear + 1) % 31;
+        (sum >> 1) as i32
+    }
+}
+#[cfg(test)] mod tests {
+    use super::*;
+    #[test] fn original_table_seed_sequence() {
+        let expected = [134421688,624679831,1175454998,389078347,362115794,1810428007,1289614418,1669641904,192096377,442316865,1966179315,188259782,1458953602,1695212072,967665137,1409341336];
+        let mut r = BsdRandom::seeded(0xb27f7);
+        for e in expected { assert_eq!(r.next(),e); }
+    }
+    #[test] fn default_is_seed_one_and_guests_do_not_interfere() {
+        let mut a=BsdRandom::default(); let mut b=BsdRandom::seeded(1);
+        let mut other=BsdRandom::seeded(9);
+        for _ in 0..2048 { other.next(); assert_eq!(a.next(), b.next()); }
+    }
+    #[cfg(target_os="macos")]
+    #[test] fn matches_darwin_libc_across_seed_and_wrap_boundaries() {
+        unsafe extern "C" { fn srandom(seed:u32); fn random()->std::ffi::c_long; }
+        for seed in [0,1,0xb27f7,0x7fffffff,0x80000000,0xffffffff] {
+            unsafe { srandom(seed); }
+            let mut r=BsdRandom::seeded(seed);
+            for i in 0..4096 { assert_eq!(r.next() as i64, unsafe{random()} as i64,"seed={seed} sample={i}"); }
+        }
+    }
+}
