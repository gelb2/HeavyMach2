+        DeviceOrientation::PortraitUpsideDown => (-horizontal, vertical),
+        DeviceOrientation::LandscapeLeft => (-vertical, -horizontal),
+        DeviceOrientation::LandscapeRight => (vertical, horizontal),
+    };
