+// Diagnostic readback is opt-in and bounded. Never used for ordinary frame timing.
+unsafe fn audit_frame(gles: &mut dyn GLES, label: &str, width: i32, height: i32) {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    if !*ENABLED.get_or_init(|| std::env::var_os("HM2_AUDIT_FRAME").is_some()) { return; }
+    static CALLS: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+    let n = CALLS.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    if ![120,121,480,481].contains(&n) || width <= 0 || height <= 0 { return; }
+    let mut pixels = vec![0u8; width as usize * height as usize * 4];
+    gles.ReadPixels(0,0,width,height,gles11::RGBA,gles11::UNSIGNED_BYTE,pixels.as_mut_ptr().cast());
+    let colored = pixels.chunks_exact(4).filter(|p| p[0] != 0 || p[1] != 0 || p[2] != 0).count();
+    log!("[HM2 frame] {} n={} size={}x{} colored={} fbo={} status={:#x}", label,n,width,height,colored,get_int(gles,gles11::FRAMEBUFFER_BINDING_OES),gles.CheckFramebufferStatusOES(gles11::FRAMEBUFFER_OES));
+    if let Some(directory) = std::env::var_os("HM2_AUDIT_FRAME_DIR") {
