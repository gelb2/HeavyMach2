+pub struct State { strings: std::collections::HashMap<String, u32> }
+
+fn stable_string(env: &mut Environment, value: String) -> u32 {
+    if let Some(&p) = env.libc_state.dlfcn.strings.get(&value) { return p; }
+    let p = env.mem.alloc_and_write_cstr(value.as_bytes()).to_bits();
+    env.libc_state.dlfcn.strings.insert(value, p);
+    p
+}
+
+// Dl_info contains four 32-bit guest pointers. Addresses refer to loaded guest
+// images, never the host process. Names remain valid for the guest lifetime.
+fn dladdr(env: &mut Environment, address: crate::mem::ConstVoidPtr, info: crate::mem::MutPtr<u32>) -> i32 {
+    let address = address.to_bits();
+    let found = env.bins.iter().enumerate().find(|(_, bin)| {
+        bin.mapped_segments.iter().any(|s| s.contains(&address))
+    });
+    let Some((index, bin)) = found else { return 0; };
+    let base = bin.image_base;
+    let path = if index == 0 { env.bundle.executable_path().as_str().to_string() } else { bin.name.clone() };
+    let symbol = bin.symbol_addresses.iter().filter(|(_,a)| **a <= address)
+        .max_by_key(|(_,a)| **a).map(|(name,&a)| (name.strip_prefix('_').unwrap_or(name).to_string(), a));
+    let file_ptr = stable_string(env, path);
+    let (symbol_ptr, symbol_address) = match symbol {
+        Some((name,a)) => (stable_string(env,name),a), None => (0,0)
+    };
+    for (i,v) in [file_ptr,base,symbol_ptr,symbol_address].into_iter().enumerate() {
+        env.mem.write(info + i as u32, v);
+    }
+    1
+}
